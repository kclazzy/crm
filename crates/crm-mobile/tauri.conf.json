{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRM",
  "version": "0.4.2",
  "identifier": "com.kclazzy.crm",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../crm-desktop/icons/32x32.png", "../crm-desktop/icons/128x128.png", "../crm-desktop/icons/icon.png"],
    "android": {
      "minSdkVersion": 26
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRM",
  "mainBinaryName": "CRM",
  "version": "0.3.2",
  "identifier": "com.kclazzy.crm",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CRM",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CRM",
    "shortDescription": "CRM — клиенты, задачи и чаты команды",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/crm-server"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}

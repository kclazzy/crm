# Служба CRM для Linux (systemd).
# Установка:
#   sudo cp crm-server /usr/local/bin/
#   sudo cp crm-server.service /etc/systemd/system/
#   sudo systemctl enable --now crm-server
[Unit]
Description=CRM Server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/crm-server --config /var/lib/crm/config.toml
# Отдельный системный пользователь без входа; данные — в /var/lib/crm (права 0700).
DynamicUser=yes
StateDirectory=crm
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
# Песочница
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
